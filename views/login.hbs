<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ingresar · BladesInsight Admin</title>
  <link rel="stylesheet" href="/admin.css">
</head>
<body class="center">
  <form class="card login" method="post" action="/login">
    <h1>BladesInsight <span>Admin</span></h1>
    {{#if error}}<p class="alert err">{{error}}</p>{{/if}}
    <div class="field"><label for="email">Correo</label><input id="email" name="email" type="email" required autofocus></div>
    <div class="field"><label for="password">Contraseña</label><input id="password" name="password" type="password" required></div>
    <button class="btn" type="submit">Ingresar</button>
  </form>
</body>
</html>
